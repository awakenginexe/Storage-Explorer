{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Storage Explorer",
  "version": "0.1.0",
  "identifier": "com.storageexplorer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Storage Explorer",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#111419"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Understand what is using your storage",
    "category": "Utility",
    "windows": { "nsis": { "installMode": "currentUser" } },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
